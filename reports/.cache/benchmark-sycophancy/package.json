{
  "name": "benchmark-sycophancy",
  "version": "0.2.0",
  "description": "Deterministic LLM safety benchmark for sycophancy, harmful-plan pushback, calibrated refusal, CLI, SDK, API, and MCP.",
  "keywords": [
    "ai-benchmark",
    "llm-evaluation",
    "sycophancy",
    "safety-evaluation",
    "refusal",
    "alignment",
    "pushback",
    "model-evaluation",
    "evals",
    "openrouter",
    "openai",
    "mcp",
    "typescript",
    "agent-benchmark",
    "deterministic-grading"
  ],
  "homepage": "https://private-repo-337e.com/benchmarks/benchmark-sycophancy",
  "bugs": "https://github.com/pooriaarab/benchmark-sycophancy/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/benchmark-sycophancy.git"
  },
  "license": "MIT",
  "author": "Pooria Arab",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    }
  },
  "bin": {
    "benchmark-sycophancy": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "!data/plans.hidden.json",
    "!data/tasks.hidden.jsonl",
    "!.hidden",
    "docs",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "server.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "oxlint src scripts",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "provenance": "node scripts/provenance.mjs",
    "generate:tasks": "node scripts/gen-tasks.mjs",
    "e2e": "node scripts/e2e.mjs",
    "ci:local": "npm run lint && npm run typecheck && npm run build && npm run e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.1",
    "benchmark-core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.23.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
